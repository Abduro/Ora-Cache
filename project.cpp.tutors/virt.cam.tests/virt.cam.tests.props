<?xml version="1.0" encoding="utf-8"?>
<!--
	Created by Tech_dog (ebontrop@gmail.com) on 21-Aug-2026 at 21:00:48.624, UTC+4, Batumi, Friday;
	This is virtual camera test solution common property page declaration file; not used yet;
  -->
<Project DefaultTargets="Build" ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup><!--$(MSBuildThisFileDirectory) always returns a path that ends with a backslash \;-->
		<Common Condition="'$(Common)'==''">$(MSBuildThisFileDirectory)test.0.common\</Common>
	</PropertyGroup>
	<PropertyGroup>
		<!--vc++ project accepts the direct reference to the file, but the project filter does not;
		    thus, $(App_Icon) and $(Manifest) are not applied to project file unfortunately;-->
		<App_Icon Condition="'$(App_Icon)' == ''">$(Common)src\resources\Icons\virt.cam_blue_512px.ico</App_Icon>
		<Manifest Condition="'$(Manifest)' == ''">$(MSBuildThisFileDirectory)virt.cam.tests.manifest</Manifest>
		<Resource Condition="'$(Resource)' == ''">$(Common)src\resources\</Resource>
		<Icon_Dir Condition="'$(Icon_Dir)' == ''">$(Resource)\Icons\</Icon_Dir>
		<!--https://www.allacronyms.com/manifest/abbreviated-->
		<Mfst_Dir Condition="'$(Mfst_Dir)' == ''">$(MSBuildThisFileDirectory)</Mfst_Dir>
	</PropertyGroup>
	<PropertyGroup>
		<_0>$(Common)interface</_0>
	</PropertyGroup>
	<PropertyGroup><!--it seems very look like a consumer project properties' file must include $(IncludePath) macro at the end of include sequence;-->
		<IncludePath>$(_0);<!--$(IncludePath)--></IncludePath><!--*important*::it does *not* work in c++ project file!-->
	</PropertyGroup>
</Project>