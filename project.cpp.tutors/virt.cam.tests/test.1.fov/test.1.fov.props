<!--
	Created by Tech_dog (ebontrop@gmail.com) on 23-Aug-2026 at 11:05:37.449, UTC+4, Batumi, Monday;
	This is 'monitor horizontal field of view calculation' test project include property page declaration file;
  -->
<Project DefaultTargets="Build" ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<!--Ebo_pack projects' includes must be reviewed;-->
		<Ebo_pack>$(SolutionDir)..\..\project.cpp\</Ebo_pack>
		<Error>$(Ebo_pack)ms.win\sys.err.core\</Error>
		<Shared>$(Ebo_pack)ms.win\sys.shared\</Shared>
		<Memory>$(Ebo_pack)ms.win\sys.mem.core\</Memory>
		<!-- https://learn.microsoft.com/en-us/cpp/build/reference/common-macros-for-build-commands-and-properties -->
		<Root>$(ProjectDir)..\</Root>
		<Test_0 Condition = "'$(Test_0)' == ''">..\test.0.common\</Test_0>
	</PropertyGroup>
	<PropertyGroup>
		<_0>interface\</_0>
		<_1>src\</_1>
		<_2>$(Test_0)interface\</_2>
		<i_err>$(Error)interface\</i_err>
		<i_shared>$(Shared)interface\</i_shared>
		<i_memory>$(Memory)interface\</i_memory>
	</PropertyGroup>
	<PropertyGroup>
		<IncludePath>$(_0);$(_1);$(_2);$(i_err);$(i_shared);$(i_memory);$(IncludePath)</IncludePath><!--*important*::it does *not* work in c++ project file!-->
	</PropertyGroup>
</Project>