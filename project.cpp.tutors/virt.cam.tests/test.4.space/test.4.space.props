<Project DefaultTargets="Build" ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<!-- https://learn.microsoft.com/en-us/cpp/build/reference/common-macros-for-build-commands-and-properties -->
		<Root>$(ProjectDir)..\</Root>
		<Test_0 Condition = "'$(Test_0)' == ''">..\test.0.common\</Test_0>
	</PropertyGroup>
	<PropertyGroup>
		<_0>interface\</_0>
		<_1>src\</_1>
		<_2>$(Test_0)interface\</_2>
	</PropertyGroup>
	<PropertyGroup>
		<IncludePath>$(_0);$(_1);$(_2);$(IncludePath)</IncludePath><!--*important*::it does *not* work in c++ project file!-->
	</PropertyGroup>
</Project>