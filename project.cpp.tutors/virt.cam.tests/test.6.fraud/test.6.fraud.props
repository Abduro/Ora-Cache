<Project DefaultTargets="Build" ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<Root Condition = "'$(Root)' == ''">$(MSBuildThisFileDirectory)..\</Root><!--this msbuild property is recognizable by command line and VS builds;-->
	<Import Project="$(Root)virt.cam.tests.props"/><!--common test project is referenced there;-->
	<PropertyGroup>
		<_0>interface\</_0>
		<_1>src\</_1>
	</PropertyGroup>
	<PropertyGroup>
		<IncludePath>$(_0);$(_1);$(IncludePath)</IncludePath><!--*important*::it does *not* work in c++ project file!-->
	</PropertyGroup>
</Project>