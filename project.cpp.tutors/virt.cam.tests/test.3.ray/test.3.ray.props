	This is 'Virtual Camera's Ray and Sphere Intersection' test project include property page declaration file;
  -->
<Project DefaultTargets="Build" ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<!-- https://learn.microsoft.com/en-us/cpp/build/reference/common-macros-for-build-commands-and-properties -->
		<Root>$(ProjectDir)..\</Root>
		<Test_0 Condition = "'$(Test_0)' == ''">..\test.0.common\</Test_0>
	</PropertyGroup>
	<!--*important*: importing the properties' pages leads to a project losts all system, sdk directory list;
	     it requires some additional settings in order to get it fixed;-->
	<!--Import Project="$([MSBuild]::GetPathOfFileAbove(virt.cam.tests.props)" /--><!--Does not work for building by VS;-->
	<!--Import Project="$(Root)virt.cam.tests.props"/--><!--common test project is referenced there;-->
	<PropertyGroup>
		<_0>interface\</_0>
		<_1>src\</_1>
		<_2>$(Test_0)interface\</_2>
	</PropertyGroup>
	<PropertyGroup>
		<IncludePath>$(_0);$(_1);$(_2);$(IncludePath)</IncludePath><!--*important*::it does *not* work in c++ project file!-->
	</PropertyGroup>
</Project>